 "html": "<div style=\"font-family: Arial, sans-serif; padding: 25px; border: 1px solid #ccc; border-radius: 8px; max-width: 650px; margin: auto; color: #333;\">\n  <div style=\"text-align: center; border-bottom: 2px solid #2563eb; padding-bottom: 10px; margin-bottom: 20px;\">\n    <h3 style=\"color: #2563eb; margin: 0; text-transform: uppercase;\">Evidence Document Review Sheet</h3>\n    <h5 style=\"color: #666; margin: 5px 0 0 0; font-weight: normal;\">NileGov Verification Audit Trail (Prototype)</h5>\n  </div>\n\n  <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 20px; font-size: 14px;\">\n    <tr>\n      <td style=\"padding: 8px; font-weight: bold; width: 35%; color: #666; border-bottom: 1px solid #eee;\">Document ID:</td>\n      <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">{{ doc.name }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 8px; font-weight: bold; color: #666; border-bottom: 1px solid #eee;\">Service Request:</td>\n      <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">{{ doc.service_request }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 8px; font-weight: bold; color: #666; border-bottom: 1px solid #eee;\">Document Type:</td>\n      <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">{{ doc.document_type }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 8px; font-weight: bold; color: #666; border-bottom: 1px solid #eee;\">Document Title:</td>\n      <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">{{ doc.document_title }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 8px; font-weight: bold; color: #666; border-bottom: 1px solid #eee;\">Verification Status:</td>\n      <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">\n        <span style=\"background-color: #fef3c7; color: #d97706; padding: 2px 8px; border-radius: 4px; font-weight: bold;\">{{ doc.verification_status }}</span>\n      </td>\n    </tr>\n    <tr>\n      <td style=\"padding: 8px; font-weight: bold; color: #666; border-bottom: 1px solid #eee;\">Verified By:</td>\n      <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">{{ doc.verified_by or 'N/A' }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 8px; font-weight: bold; color: #666; border-bottom: 1px solid #eee;\">Verified Timestamp:</td>\n      <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">{{ doc.verified_timestamp or 'N/A' }}</td>\n    </tr>\n  </table>\n\n  <div style=\"margin-top: 15px; margin-bottom: 25px;\">\n    <p style=\"margin: 5px 0; font-weight: bold; color: #666;\">Verification Notes:</p>\n    <div style=\"background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px; padding: 12px; font-style: italic; min-height: 50px;\">\n      {{ doc.officer_notes or 'No officer notes entered.' }}\n    </div>\n  </div>\n\n  <div style=\"background-color: #fef2f2; border: 1px solid #fca5a5; border-radius: 6px; padding: 12px; font-size: 11px; color: #b91c1c; text-align: center; font-weight: bold;\">\n    Disclaimer: {{ doc.disclaimer or 'Prototype simulation only. No live Government registry access or verification was executed.' }}\n  </div>\n</div>"
}
