 "html": "<div style=\"font-family: Arial, sans-serif; padding: 25px; border: 1px solid #64748b; border-radius: 8px; max-width: 700px; margin: auto; color: #1e293b;\">\n  <div style=\"text-align: center; border-bottom: 2px solid #64748b; padding-bottom: 10px; margin-bottom: 20px;\">\n    <h3 style=\"color: #64748b; margin: 0; text-transform: uppercase;\">M&E Performance Summary Brief</h3>\n    <h5 style=\"color: #64748b; margin: 5px 0 0 0; font-weight: normal;\">Monitoring & Evaluation Reporting Metrics (Prototype)</h5>\n  </div>\n\n  <div style=\"background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 12px; margin-bottom: 20px; font-size: 14px;\">\n    <p style=\"margin: 5px 0;\"><strong>Snapshot ID:</strong> {{ doc.name }}</p>\n    <p style=\"margin: 5px 0;\"><strong>Snapshot Name:</strong> {{ doc.snapshot_name }}</p>\n    <p style=\"margin: 5px 0;\"><strong>Period:</strong> {{ doc.reporting_period_start }} to {{ doc.reporting_period_end }}</p>\n    <p style=\"margin: 5px 0;\"><strong>Generated At:</strong> {{ doc.generated_at }} by {{ doc.generated_by }}</p>\n  </div>\n\n  <h4 style=\"color: #475569; border-bottom: 1px solid #cbd5e1; padding-bottom: 5px; margin-top: 25px;\">Key Metrics Summary</h4>\n  <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 25px; font-size: 14px;\">\n    <tr style=\"border-bottom: 1px solid #e2e8f0;\">\n      <td style=\"padding: 10px; font-weight: bold;\">Total Service Requests Compiled:</td>\n      <td style=\"padding: 10px; text-align: right;\">{{ doc.total_requests or 0 }}</td>\n    </tr>\n    <tr style=\"border-bottom: 1px solid #e2e8f0;\">\n      <td style=\"padding: 10px; font-weight: bold;\">Cases Resolved Within SLA:</td>\n      <td style=\"padding: 10px; text-align: right; color: #16a34a;\">{{ doc.within_sla_count or 0 }}</td>\n    </tr>\n    <tr style=\"border-bottom: 1px solid #e2e8f0;\">\n      <td style=\"padding: 10px; font-weight: bold;\">Cases Flagged At Risk:</td>\n      <td style=\"padding: 10px; text-align: right; color: #d97706;\">{{ doc.at_risk_count or 0 }}</td>\n    </tr>\n    <tr style=\"border-bottom: 1px solid #e2e8f0;\">\n      <td style=\"padding: 10px; font-weight: bold;\">Cases Overdue (SLA Breached):</td>\n      <td style=\"padding: 10px; text-align: right; color: #dc2626;\">{{ doc.overdue_count or 0 }}</td>\n    </tr>\n    <tr style=\"border-bottom: 1px solid #e2e8f0;\">\n      <td style=\"padding: 10px; font-weight: bold;\">Escalated supervisor review tickets:</td>\n      <td style=\"padding: 10px; text-align: right;\">{{ doc.escalated_count or 0 }}</td>\n    </tr>\n  </table>\n\n  <div style=\"background-color: #fef2f2; border: 1px solid #fca5a5; border-radius: 6px; padding: 12px; font-size: 11px; color: #b91c1c; text-align: center; font-weight: bold;\">\n    Disclaimer: {{ doc.disclaimer or 'Prototype reporting snapshot only. Metrics are calculated from fictional demo data and are not official government statistics.' }}\n  </div>\n</div>"
