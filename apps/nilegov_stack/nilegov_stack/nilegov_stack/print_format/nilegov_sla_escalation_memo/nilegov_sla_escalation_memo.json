 "html": "<div style=\"font-family: Arial, sans-serif; padding: 25px; border: 1px solid #e11d48; border-radius: 8px; max-width: 650px; margin: auto; color: #333;\">\n  <div style=\"text-align: center; border-bottom: 2px solid #e11d48; padding-bottom: 10px; margin-bottom: 20px;\">\n    <h3 style=\"color: #e11d48; margin: 0; text-transform: uppercase;\">SLA Escalation Memo</h3>\n    <h5 style=\"color: #666; margin: 5px 0 0 0; font-weight: normal;\">NileGov SLA Monitoring Notification (Prototype)</h5>\n  </div>\n\n  <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 20px; font-size: 14px;\">\n    <tr>\n      <td style=\"padding: 8px; font-weight: bold; width: 35%; color: #666; border-bottom: 1px solid #eee;\">Escalation Hash ID:</td>\n      <td style=\"padding: 8px; border-bottom: 1px solid #eee; font-family: monospace;\">{{ doc.name }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 8px; font-weight: bold; color: #666; border-bottom: 1px solid #eee;\">Service Request Link:</td>\n      <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">{{ doc.service_request }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 8px; font-weight: bold; color: #666; border-bottom: 1px solid #eee;\">Escalated By:</td>\n      <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">{{ doc.escalated_by }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 8px; font-weight: bold; color: #666; border-bottom: 1px solid #eee;\">Escalated To (Supervisor):</td>\n      <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">{{ doc.escalated_to }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 8px; font-weight: bold; color: #666; border-bottom: 1px solid #eee;\">Escalated Timestamp:</td>\n      <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">{{ doc.escalated_at }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 8px; font-weight: bold; color: #666; border-bottom: 1px solid #eee;\">Current Memo Status:</td>\n      <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">\n        <span style=\"background-color: #ffe4e6; color: #e11d48; padding: 2px 8px; border-radius: 4px; font-weight: bold;\">{{ doc.status }}</span>\n      </td>\n    </tr>\n    <tr>\n      <td style=\"padding: 8px; font-weight: bold; color: #666; border-bottom: 1px solid #eee;\">Resolution Timestamp:</td>\n      <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">{{ doc.resolved_at or 'Pending Resolution' }}</td>\n    </tr>\n  </table>\n\n  <div style=\"margin-top: 15px; margin-bottom: 25px;\">\n    <p style=\"margin: 5px 0; font-weight: bold; color: #666;\">Reason for Escalation:</p>\n    <div style=\"background-color: #fff1f2; border: 1px solid #ffe4e6; border-radius: 6px; padding: 12px; font-style: italic; color: #9f1239;\">\n      {{ doc.escalation_reason }}\n    </div>\n  </div>\n\n  <div style=\"background-color: #fef2f2; border: 1px solid #fca5a5; border-radius: 6px; padding: 12px; font-size: 11px; color: #b91c1c; text-align: center; font-weight: bold;\">\n    Disclaimer: Prototype simulation only. All escalations are part of a demonstration flow and do not represent active ministry escalation routes.\n  </div>\n</div>"
}
