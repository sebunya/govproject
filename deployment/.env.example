# NileGov Stack Deployment Configuration Variables
# Rename this file to .env and configure secret keys before launching Docker Compose.

# 1. Base Image Settings
# Official Frappe/ERPNext image tag (e.g. v15.15.0, v15.20.0, or latest)
APP_VERSION=v15.15.0

# 2. Database Secrets (MariaDB Container Settings)
DB_ROOT_PASSWORD=change_this_to_a_secure_root_password_123!
DB_NAME=nilegov_db
DB_USER=nilegov_user
DB_PASSWORD=change_this_to_a_secure_app_db_password_456!

# 3. Application Site Settings (Used during site creation)
SITE_NAME=nilegov.yourdomain.com
ADMIN_PASSWORD=change_this_to_a_secure_desk_admin_password_789!
