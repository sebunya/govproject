# ─────────────────────────────────────────────────────────────────────────────
# NileGov Stack — Environment Variables
# Copy this file to server/.env and fill in real values to activate live APIs.
# Without these vars, all channels fall back to safe simulation mode.
# ─────────────────────────────────────────────────────────────────────────────

# ─── SMS — Africa's Talking ──────────────────────────────────────────────────
# Dashboard: https://account.africastalking.com
# Use username "sandbox" + sandbox API key for testing; live key for production.
AT_API_KEY=your_africastalking_api_key
AT_USERNAME=sandbox
AT_SENDER_ID=NILEGOV

# ─── EMAIL — ZeptoMail (Zoho) ────────────────────────────────────────────────
# Dashboard: https://zeptomail.zoho.com
# Create a mail agent → get the "Send Mail" token (starts with Ph5...)
ZEPTO_API_KEY=your_zeptomail_api_key
ZEPTO_FROM_EMAIL=noreply@mbarara.go.ug
ZEPTO_FROM_NAME=NileGov Stack

# ─── WHATSAPP — Meta Business API ────────────────────────────────────────────
# Setup: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
# Requirements: Meta Business Account → WhatsApp Business App → Phone Number
# Use a permanent (never-expiring) system user token for production.
META_WHATSAPP_TOKEN=your_meta_whatsapp_permanent_token
META_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# ─── PAYMENTS — Pesapal API 3.0 ──────────────────────────────────────────────
# Sandbox dashboard: https://demo.pesapal.com
# Live dashboard:    https://www.pesapal.com/dashboard
# IPN URL must be publicly accessible (use ngrok for local dev).
PESAPAL_CONSUMER_KEY=your_pesapal_consumer_key
PESAPAL_CONSUMER_SECRET=your_pesapal_consumer_secret
PESAPAL_IPN_URL=https://your-domain.com/api/pesapal/ipn
PESAPAL_SANDBOX=true

# ─── APP SETTINGS ────────────────────────────────────────────────────────────
# Public-facing base URL — used for Pesapal callback and IPN registration.
APP_URL=https://your-domain.com
PORT=3001
NODE_ENV=production
