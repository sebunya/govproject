{
  "name": "nilegov-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--experimental-sqlite' ../node_modules/.bin/tsx --env-file=.env watch src/index.ts",
    "build": "tsc",
    "start": "NODE_OPTIONS='--experimental-sqlite' node --env-file=.env dist/index.js",
    "seed": "NODE_OPTIONS='--experimental-sqlite' ../node_modules/.bin/tsx src/seed.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "node-sqlite3-wasm": "^0.8.57",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.7",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
